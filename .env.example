# 仅本地开发。建议 npm run setup:env 随机生成，不要直接使用下面占位秘密。
# .env禁止提交仓库，前端配置不得加入数据库URL或任何后端秘密。
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
WEB_PORT=5173
PORT=3000
HOST=127.0.0.1
SESSION_TTL_SECONDS=604800
CSRF_SECRET=replace_with_at_least_32_random_characters
POSTGRES_ADMIN_PASSWORD=replace_with_random_admin_password
POSTGRES_APP_PASSWORD=replace_with_random_app_password
# 原生API连接可选回环数据库端口；密码含特殊字符时必须URL编码。
# Compose内部由PG*字段构造连接，不使用宿主机127.0.0.1。
DATABASE_URL=postgresql://campus_app:replace_with_random_app_password@127.0.0.1:5432/campus
